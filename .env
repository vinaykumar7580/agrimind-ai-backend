# App
APP_SECRET_KEY=your-super-secret-key-change-in-production
APP_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
